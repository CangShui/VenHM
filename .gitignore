# Signing material must never enter the repository. Keep the certificate,
# profile and password only on your own machine (DevEco > Project Structure >
# Signing Configs) or in an untracked local build profile.
*.p12
*.cer
*.p7b
*.csr
*.keystore
*.jks
signing-config.json5
build-profile.local.json5

# DevEco preview/analysis caches contain absolute local paths.
**/.preview/
*.log

# Python/OS caches contain absolute local paths.
**/__pycache__/
*.pyc
.DS_Store
Thumbs.db
